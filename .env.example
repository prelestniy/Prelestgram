# ==========================================================
#  Prelestgram — конфигурация сервера (скопируй в .env)
# ==========================================================

# --- Общие настройки приложения ---
APP_NAME=Prelestgram
# dev | prod
APP_ENV=prod
# Публичный адрес API, по которому к серверу ходит Android-клиент
API_PUBLIC_URL=http://192.168.1.10:8000
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- JWT и сессии ---
# Сгенерируй: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-long-random-string
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=90

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=prelestgram
POSTGRES_USER=prelestgram
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (хранилище медиа) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=prelestgram
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=prelestgram-media
MINIO_SECURE=false
# Максимальный размер загружаемого файла (МБ)
MAX_UPLOAD_MB=50

# --- Telegram-бот администратора (aiogram 3) ---
# Токен от @BotFather. Бот нужен ТОЛЬКО для выдачи номеров/кодов и админки.
BOT_TOKEN=123456789:AAAA-your-bot-token
# Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_TELEGRAM_IDS=111111111

# --- Авторизация по кодам ---
# Префикс выдаваемых номеров, номер = префикс + порядковый номер с ведущими нулями
PHONE_PREFIX=+7000
# Общая длина номера в цифрах после "+" (для +70000000001 это 11)
PHONE_DIGITS=11
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_SECONDS=60

# --- Правила экономики (по умолчанию — строго: всё только от админа) ---
# Разрешить пользователям переводить звёзды друг другу
ALLOW_STAR_TRANSFERS=false
# Разрешить пользователям дарить подарки из каталога за свои звёзды
ALLOW_USER_GIFT_PURCHASE=false
# Разрешить пользователям передавать NFT друг другу
ALLOW_NFT_TRANSFERS=false
